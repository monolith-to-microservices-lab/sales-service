# ---------------------------------------------------------------------------
# sales-service configuration
# Copy this file to `.env` and adjust for your environment.
# No secrets are committed to the repository.
# ---------------------------------------------------------------------------

# SQLAlchemy / psycopg2 connection string for the Sales Service database.
# This MUST point only to the Sales Service's own PostgreSQL instance.
# It must NEVER point to the legacy monolith DB or the User Service DB.
DATABASE_URL=postgresql+psycopg2://sales:sales@sales-postgres:5432/sales

# Application environment: development | staging | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Logical service name (used in structured logs and health output).
SERVICE_NAME=sales-service

# --- CDC consumer (app/cdc, `python -m app.cdc`, a separate process) -------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SALES_TOPIC=legacy.public.sales
KAFKA_CONSUMER_GROUP=sales-service-cdc
KAFKA_AUTO_OFFSET_RESET=earliest
CDC_METRICS_PORT=9201

# OTLP endpoint for traces (monolith/user-service/sales-service-cdc all send
# here; see observability-infrastructure).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
